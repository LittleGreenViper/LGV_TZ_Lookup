# LGV_TZ_Lookup HTML documentation.
#
# Run ./generate-docs.sh from the project root. For Doxywizard or a direct build,
# use this file with docs as the working directory. All paths below are relative
# to that directory. The shell script also copies the README's image directory
# and replaces stale generated pages after a successful build.
#
# Keep this configuration focused on the settings we actually use. Doxygen's
# defaults supply the remaining options. Verified with Doxygen 1.18.0.

#---------------------------------------------------------------------------
# Project and output
#---------------------------------------------------------------------------
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = LGV_TZ_Lookup
PROJECT_NUMBER         = 1.4.0
PROJECT_BRIEF          = "Time zone lookup for PHP applications and HTTP clients"
PROJECT_LOGO           = ../img/icon.png
OUTPUT_DIRECTORY       = .
OUTPUT_LANGUAGE        = English
TIMESTAMP              = NO
SHORT_NAMES            = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ..
STRIP_FROM_INC_PATH    = ..

#---------------------------------------------------------------------------
# The README is the landing page; all project-owned PHP is included.
# Vendor code, downloaded data, and generated documentation stay outside input.
#---------------------------------------------------------------------------
INPUT                  = ../README.md \
                         ../CHANGELOG.md \
                         ../src \
                         ../demo \
                         ../tests \
                         ../tools \
                         ../index.php \
                         navigation.dox \
                         markdown-filter.php \
                         finalize-html.php
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.php *.md *.dox
RECURSIVE              = YES
EXCLUDE                = ../src/vendor ../vendor html
EXCLUDE_PATTERNS       = */vendor/* */docs/html/* *.json *.zip
EXCLUDE_SYMLINKS       = YES
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 3
IMPLICIT_DIR_DOCS      = NO
USE_MDFILE_AS_MAINPAGE = ../README.md
IMAGE_PATH             = ../img
FILTER_PATTERNS        = *.md="php markdown-filter.php"
FILTER_SOURCE_FILES    = NO
EXAMPLE_PATH           = . .. ../demo ../tools ../tests
EXAMPLE_PATTERNS       = *.sh *.php Doxyfile
EXAMPLE_RECURSIVE      = NO

#---------------------------------------------------------------------------
# Include implementation details, while keeping the class reference readable.
#---------------------------------------------------------------------------
OPTIMIZE_OUTPUT_FOR_C  = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
INTERNAL_DOCS          = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_SCOPE_NAMES       = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = NO
JAVADOC_AUTOBRIEF      = NO
INHERIT_DOCS           = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBER_DOCS       = YES
SORT_MEMBERS_CTORS_1ST = YES
ALPHABETICAL_INDEX     = YES
IGNORE_PREFIX          = LGV_TZ_Lookup_ Demo
MAX_INITIALIZER_LINES  = 0
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
SHOW_INCLUDE_FILES     = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES

#---------------------------------------------------------------------------
# Static HTML, suitable for GitHub Pages from the docs directory.
# Search runs in the browser and requires no PHP service.
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_EXTRA_STYLESHEET  = style.css
HTML_EXTRA_FILES       = .nojekyll ../tests/benchmarks/query-2026-10-07.json ../tests/benchmarks/postgres-2026-10-09.json
LAYOUT_FILE            = layout.xml
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
TREEVIEW_WIDTH         = 300
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

#---------------------------------------------------------------------------
# Graphviz is optional. The build script disables graphs if dot is unavailable.
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_PATH               =
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 50
DOT_CLEANUP            = YES

#---------------------------------------------------------------------------
# Build diagnostics. Keep warnings visible without requiring every legacy
# symbol to have a complete parameter description before docs can be built.
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           =
